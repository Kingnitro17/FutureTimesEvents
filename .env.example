# ─────────────────────────────────────────────────────────────
# Future Times Events — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key_here

# Service role key — ONLY for server-side admin operations.
# NEVER expose to browser. NEVER commit to git.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key_here

# ── Site configuration ────────────────────────────────────────
# The production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.futuretimesevents.com

# App version — used in /api/health
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Email (optional — P1 feature) ─────────────────────────────
# Resend API key for transactional emails (ticket confirmations etc.)
# Sign up at: https://resend.com
# RESEND_API_KEY=re_...your_key_here

# SendGrid alternative:
# SENDGRID_API_KEY=SG...your_key_here
# EMAIL_FROM=tickets@futuretimesevents.com

# Event-review notifications (server only; never prefix these with NEXT_PUBLIC_)
# Meta WhatsApp Cloud API (provider-initiated delivery may require an approved template)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_EVENT_REVIEW_TEMPLATE=
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=reviews@futuretimesevents.com

# ── Feature flags (optional) ──────────────────────────────────
# NEXT_PUBLIC_ENABLE_MAPS=true
# NEXT_PUBLIC_ENABLE_WHOS_GOING=true
# NEXT_PUBLIC_MAINTENANCE_MODE=false
